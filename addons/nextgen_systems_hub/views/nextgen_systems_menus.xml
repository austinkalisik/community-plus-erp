<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_open_onesuite" model="ir.actions.act_url">
        <field name="name">NextGen Platform</field>
        <field name="url">/platform</field>
        <field name="target">self</field>
    </record>

    <record id="action_open_nexerp" model="ir.actions.act_url">
        <field name="name">NexERP</field>
        <field name="url">https://nexerp.nextgenpng.net</field>
        <field name="target">new</field>
    </record>

    <record id="action_open_b2b_store" model="ir.actions.act_url">
        <field name="name">B2B Store</field>
        <field name="url">https://store.nextgenpng.net</field>
        <field name="target">new</field>
    </record>

    <record id="action_open_sms" model="ir.actions.act_url">
        <field name="name">SMS Gateway</field>
        <field name="url">https://sms.tidalwavesoftwebsolutions.tech</field>
        <field name="target">new</field>
    </record>

    <record id="action_open_paperclip" model="ir.actions.act_url">
        <field name="name">Paperclip</field>
        <field name="url">https://paperclip.tidalwavesoftwebsolutions.tech</field>
        <field name="target">new</field>
    </record>

    <record id="action_open_godseye" model="ir.actions.act_url">
        <field name="name">God's Eye</field>
        <field name="url">https://godseye.tidalwavesoftwebsolutions.tech</field>
        <field name="target">new</field>
    </record>

    <record id="action_open_support" model="ir.actions.act_url">
        <field name="name">NextGen Support</field>
        <field name="url">https://nextgenpng.net/support/</field>
        <field name="target">new</field>
    </record>

    <record id="action_open_company_site" model="ir.actions.act_url">
        <field name="name">NextGen Website</field>
        <field name="url">https://nextgenpng.net</field>
        <field name="target">new</field>
    </record>


    <menuitem
        id="menu_nextgen_systems_root"
        name="NextGen Platform"
        sequence="1"
        groups="base.group_user"
    />


    <menuitem
        id="menu_nextgen_onesuite"
        name="Platform Home"
        parent="menu_nextgen_systems_root"
        action="action_open_onesuite"
        sequence="5"
        groups="base.group_user"
    />

    <menuitem
        id="menu_nextgen_nexerp"
        name="NexERP"
        parent="menu_nextgen_systems_root"
        action="action_open_nexerp"
        sequence="10"
        groups="base.group_user"
    />

    <menuitem
        id="menu_nextgen_store"
        name="B2B Store"
        parent="menu_nextgen_systems_root"
        action="action_open_b2b_store"
        sequence="20"
        groups="base.group_user"
    />

    <menuitem
        id="menu_nextgen_sms"
        name="SMS Gateway"
        parent="menu_nextgen_systems_root"
        action="action_open_sms"
        sequence="30"
        groups="base.group_user"
    />

    <menuitem
        id="menu_nextgen_paperclip"
        name="Paperclip"
        parent="menu_nextgen_systems_root"
        action="action_open_paperclip"
        sequence="40"
        groups="base.group_user"
    />

    <menuitem
        id="menu_nextgen_godseye"
        name="God's Eye"
        parent="menu_nextgen_systems_root"
        action="action_open_godseye"
        sequence="50"
        groups="base.group_user"
    />

    <menuitem
        id="menu_nextgen_support"
        name="Support"
        parent="menu_nextgen_systems_root"
        action="action_open_support"
        sequence="60"
        groups="base.group_user"
    />

    <menuitem
        id="menu_nextgen_website"
        name="Corporate Website"
        parent="menu_nextgen_systems_root"
        action="action_open_company_site"
        sequence="70"
        groups="base.group_user"
    />

</odoo>
